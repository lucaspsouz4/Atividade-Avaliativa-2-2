vertices = []
matriz = []


def inserir_vertice(v):
  if v not in vertices:
    vertices.append(v)
    for linha in matriz:
      linha.append(0)
    matriz.append([0] * len(vertices))
    print(f"Vertice {v} foi adicionado ! ")
  else:
    print("O vertice adicionado ja existe !")


def remover_vertice(v):
  if v in vertices:
    idx = vertices.index(v)
    vertices.remove(v)
    matriz.pop(idx)
    for linha in matriz:
      linha.pop(idx)
    print(f"Vertice {v} foi removido !")
  else:
    print(f"O vertice {v} nao existe !")


def inserir_aresta(u, v):
  if u not in vertices:
    inserir_vertice(u)
  if v not in vertices:
    inserir_vertice(v)

  i = vertices.index(u)
  j = vertices.index(v)

  matriz[i][j] = 1
  matriz[j][i] = 1
  print(f"A aresta entre '{u}' e '{v}' foi adicionada !")


def remover_aresta(u, v):
  if u in vertices and v in vertices:
    i = vertices.index(u)
    j = vertices.index(v)
    matriz[i][j] = 0
    matriz[j][i] = 0
    print(f"A aresta entre '{u}' e '{v}' foi removida com sucesso !")
  else:
    print("A aresta digitada nao existe !")


def calcular_grau(v):
  if v in vertices:
    i = vertices.index(v)
    grau = sum(matriz[i])
    print(f"O grau do vertice '{v}' é {grau}.")
    return grau
  else:
    print(f"O vertice '{v}' não existe.")
    return 0


def verificar_aresta(u, v):
  if u in vertices and v in vertices:
    i = vertices.index(u)
    j = vertices.index(v)
    if matriz[i][j] == 1:
      print("A aresta digitada existe !")
      return True
  print("A aresta digitada nao existe !")
  return False


def listar_vizinho(v):
  if v in vertices:
    i = vertices.index(v)
    vizinhos = []
    for j in range(len(vertices)):
      if matriz[i][j] == 1:
        vizinhos.append(vertices[j])
    print(f"Vizinhos do vertice '{v}': {vizinhos}")
  else:
    print(f"O vertice '{v}' não existe ou nao possui vizinhos.")


def verificar_percurso(percurso):
  for i in range(len(percurso) - 1):
    u = percurso[i]
    v = percurso[i + 1]
    if (
        u not in vertices
        or v not in vertices
        or matriz[vertices.index(u)][vertices.index(v)] == 0
    ):
      print(
          f"O percurso {percurso} nao é possivel (falha com os vertices '{u}'"
          f" e '{v}') . "
      )
      return False
  print(f"O percurso {percurso} é possivel .")
  return True


def _dfs_recursivo(atual, visitados, ordem_visita):
  visitados.add(atual)
  ordem_visita.append(atual)
  i = vertices.index(atual)

  for j in range(len(vertices)):
    if matriz[i][j] == 1:
      vizinho = vertices[j]
      if vizinho not in visitados:
        _dfs_recursivo(vizinho, visitados, ordem_visita)


def busca_profundidade(inicio):
  if inicio not in vertices:
    print(f"O vértice '{inicio}' não existe no grafo.")
    return []

  visitados = set()
  ordem_visita = []
  _dfs_recursivo(inicio, visitados, ordem_visita)

  print(f"Ordem de visitação (DFS) a partir de '{inicio}': {ordem_visita}")
  return ordem_visita


def _tem_ciclo_dfs(atual, pai, visitados):
  visitados.add(atual)
  i = vertices.index(atual)

  for j in range(len(vertices)):
    if matriz[i][j] == 1:
      vizinho = vertices[j]
      if vizinho not in visitados:
        if _tem_ciclo_dfs(vizinho, atual, visitados):
          return True
      elif vizinho != pai:
        return True

  return False


def detectar_ciclo_dfs():
  if not vertices:
    print("O grafo esta vazio. Não há ciclos.")
    return False

  visitados = set()
  for v in vertices:
    if v not in visitados:
      if _tem_ciclo_dfs(v, None, visitados):
        print("Ciclo detectado no grafo (via DFS)!")
        return True

  print("Nenhum ciclo detectado no grafo (via DFS).")
  return False


def exibir_grafo():
  if not vertices:
    print("O grafo esta vazio.")
    return
  print("Vertices: ", vertices)
  print("Matriz de adjacencia: ")
  for linha in matriz:
    print(linha)


def main():
  while True:
    print("\nEscolha uma das opcoes: ")
    print("1. Inserir vertice")
    print("2. Inserir aresta")
    print("3. Remover vertice")
    print("4. Remover aresta")
    print("5. Calcular grau de um vertice")
    print("6. Verificar existencia de aresta")
    print("7. Listar vizinhos de um vertice")
    print("8. Verificar percurso")
    print("9. Exibir grafo")
    print("10. Busca em Profundidade (DFS)")
    print("11. Detectar Ciclo (DFS)")
    print("0. Sair")

    escolha = input("Digite o numero da opcao desejada: ").strip()

    if escolha == "1":
      v = input("Digite o nome do vertice a ser inserido: ").strip()
      inserir_vertice(v)
    elif escolha == "2":
      u = input("Digite o primeiro vertice: ").strip()
      v = input("Digite o segundo vertice: ").strip()
      inserir_aresta(u, v)
    elif escolha == "3":
      v = input("Digite o nome do vertice a ser removido: ").strip()
      remover_vertice(v)
    elif escolha == "4":
      u = input("Digite o primeiro vertice: ").strip()
      v = input("Digite o segundo vertice: ").strip()
      remover_aresta(u, v)
    elif escolha == "5":
      v = input("Digite o nome do vertice para calcular o grau: ").strip()
      calcular_grau(v)
    elif escolha == "6":
      u = input("Digite o primeiro vertice: ").strip()
      v = input("Digite o segundo vertice: ").strip()
      verificar_aresta(u, v)
    elif escolha == "7":
      u = input("Digite o vertice para listar os vizinhos: ").strip()
      listar_vizinho(u)
    elif escolha == "8":
      entrada = input(
          "Digite o percurso, separado por virgulas (A,B,C etc) : "
      ).strip()
      percurso = [x.strip() for x in entrada.split(",")]
      verificar_percurso(percurso)
    elif escolha == "9":
      exibir_grafo()
    elif escolha == "10":
      v = (
          input("Digite o vértice inicial para a Busca em Profundidade: ")
          .strip()
      )
      busca_profundidade(v)
    elif escolha == "11":
      detectar_ciclo_dfs()
    elif escolha == "0":
      print("Saindo do programa .")
      break
    else:
      print("Opcao invalida. Tente novamente.")


if __name__ == "__main__":
  main()
